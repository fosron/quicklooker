				<string>com.fosron.quicklooker.toml</string>
				<string>com.fosron.quicklooker.env</string>
				<string>net.daringfireball.markdown</string>
				<string>public.comma-separated-values-text</string>
				<string>public.xml</string>
				<string>public.source-code</string>
				<string>public.script</string>
				<string>public.shell-script</string>
				<string>public.python-script</string>
				<string>public.plain-text</string>
				<string>public.text</string>
				<string>public.database</string>
				<string>com.apple.sqlite</string>
				<string>public.zip-archive</string>
				<string>com.pkware.zip-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<string>com.fosron.quicklooker.gzip</string>
				<string>public.tar-archive</string>
				<string>com.fosron.quicklooker.tar</string>
			</array>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewProvider</string>
	</dict>
